# Copy to .env. Never commit real secrets.

APP_ENV=development
APP_SECRET=change-me-to-a-long-random-string
CREDENTIALS_ENCRYPTION_KEY=  # required in production. python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=  # previous Fernet key during rotation only
# Local default. Production: PUBLIC_BASE_URL=https://codecare.si
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Include the production origins so a copied env can serve https://codecare.si.
API_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://codecare.si,https://www.codecare.si
# Leave empty for localhost. Production: COOKIE_DOMAIN=.codecare.si
COOKIE_DOMAIN=

# PostgreSQL (required in production). Tests use SQLite automatically.
DATABASE_URL=postgresql+psycopg2://codecare:codecare@127.0.0.1:5432/codecare

# Optional. When unset, jobs run in-process.
REDIS_URL=

# Optional hosted auth. Local email/password always works.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# Email. Leave SMTP_HOST empty in development to print links in the API log.
# Production mail uses SMTP and does not pretend a message was sent when it is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=CodeCare <noreply@codecare.si>
SMTP_TLS=true

# GitHub App (required for repository access). Leave empty to keep GitHub disconnected.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=  # PEM with \n escaped, or path via GITHUB_APP_PRIVATE_KEY_PATH
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_SCOPES=read:user,user:email
# Production OAuth and webhook URLs (register the callback on the GitHub App):
# https://codecare.si/api/v1/auth/github/callback is not separate — sign-in and identity connect share
# https://codecare.si/api/v1/github/oauth/callback
# Setup URL: https://codecare.si/api/v1/github/setup
# Webhook URL: https://codecare.si/api/v1/webhooks/github
# Stripe webhook URL: https://codecare.si/api/v1/webhooks/stripe

# AI providers (optional). Heuristic analysis is used when none are set.
AI_PROVIDER=auto
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Sandbox. Customer code never runs on the API host.
DISABLE_WORKER=false
SCAN_INTERVAL_HOURS=24
MAX_JOB_ATTEMPTS=3
SANDBOX_IMAGE=codecare-sandbox:local
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_INSTALL_TIMEOUT_SECONDS=180
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=128

# Stripe. Checkout stays disabled until these are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
