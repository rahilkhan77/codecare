# Copy to .env. Never commit real secrets.

# development locally, production on the server. Production refuses SQLite, weak secrets, and DEMO_MODE.
APP_ENV=development
# Long random string, at least 32 characters. Signs session cookies.
APP_SECRET=change-me-to-a-long-random-string
# Fernet key. Required in production. python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
# Previous Fernet key, only while rotating.
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=
# Public site origin. Production: https://codecare.si
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Browser origins allowed to call the API with cookies.
API_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://codecare.si,https://www.codecare.si
# Empty locally. Production: .codecare.si
COOKIE_DOMAIN=
# PostgreSQL URL. Required in production. Tests ignore this and use SQLite.
DATABASE_URL=postgresql+psycopg2://codecare:codecare@127.0.0.1:5432/codecare
# Password for the Compose Postgres service. Required by docker-compose.prod.yml.
POSTGRES_PASSWORD=change-me
# Optional Redis URL. Jobs run in-process when this is empty.
REDIS_URL=
# true only for local review. Seeds demo@codecare.si and allows sample apps and demo billing. Refused in production.
DEMO_MODE=false

# Optional Supabase JWT exchange. Local email and password work without these.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

# SMTP. Empty host prints mail to the API log in development and refuses to claim a send in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=CodeCare <noreply@codecare.si>
SMTP_TLS=true

# GitHub App. All four of id, client id, client secret, and private key are required before live repos work.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM with literal \n escapes, or leave empty and set the path below.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
# Shared secret for https://codecare.si/api/v1/webhooks/github
GITHUB_WEBHOOK_SECRET=
# Identity scopes for sign-in and Connect GitHub identity.
GITHUB_OAUTH_SCOPES=read:user,user:email

# Hosted model. If all keys are empty, diagnosis stays heuristic and does not invent a patch.
AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Set to 1 on the API container so the worker runs separately.
DISABLE_WORKER=false
# Default scan cadence in hours when a repo has none.
SCAN_INTERVAL_HOURS=24
# Retries for transient GitHub or model failures.
MAX_JOB_ATTEMPTS=3
# Image from sandbox/Dockerfile. Build with: docker compose -f docker-compose.prod.yml --profile sandbox build sandbox
SANDBOX_IMAGE=codecare-sandbox:local
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_INSTALL_TIMEOUT_SECONDS=180
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=128

# Razorpay Subscriptions, billed in USD. Checkout stays disabled until the key id, key secret, and starter plan exist.
RAZORPAY_KEY_ID=
# Secret key. Used to call the API and to verify Checkout.js payment signatures. Never sent to the browser.
RAZORPAY_KEY_SECRET=
# Webhook secret for https://codecare.si/api/v1/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Dashboard plan IDs. Create them in USD: Starter $29, Indie $79, Studio $199.
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_INDIE=
RAZORPAY_PLAN_STUDIO=
